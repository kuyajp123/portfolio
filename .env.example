# -----------------------------------------------------------------------------
# Frontend Client Variables (Vite SPA)
# Note: These are embedded into the client bundle at build time.
# -----------------------------------------------------------------------------
VITE_DISCORD_USER_ID=

# -----------------------------------------------------------------------------
# Serverless Netlify Functions Variables (Server-Only Secrets)
# Note: These are secure and never exposed to the frontend browser bundle.
# Set these in your Netlify Dashboard and local .env for Netlify CLI.
# -----------------------------------------------------------------------------
API_NINJAS_KEY=
LASTFM_API_KEY=
LASTFM_USERNAME=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
